# Copy to .env and fill in. Read automatically by docker-compose. NOT committed (gitignored).
# Every value here is optional — the app runs with no .env at all (no login, ./data dirs).

# --- Library storage ------------------------------------------------------
# Where your epubs live and where in-progress downloads land. Leave unset to use
# self-contained ./data/books and ./data/staging next to docker-compose.yml.
# Point these at an existing library folder if you already have one.
EBOOK_LIB_BOOKS_DIR=
EBOOK_LIB_STAGING_DIR=

# --- Login ----------------------------------------------------------------
# Login is enabled ONLY when EBOOK_LIB_PASSWORD is non-empty, so a LAN-only
# instance stays frictionless. Set a password before exposing the app publicly.
EBOOK_LIB_PASSWORD=

# Optional second factor. Leave empty for password-only login (no username field).
EBOOK_LIB_USERNAME=

# Set to 1 only if EVERY entry point is HTTPS. Leave empty for plain-http LAN
# access (otherwise the session cookie is dropped over http and login loops).
EBOOK_LIB_COOKIE_SECURE=

# --- Optional acquisition plugin (IRC) ------------------------------------
# Book acquisition is intentionally NOT bundled with HonLib. To enable it,
# add an external plugin as a git submodule at acquisition/irc/ — see README.
# That plugin reads its own env vars (typically EBOOK_LIB_IRC_NICK,
# EBOOK_LIB_IRC_SERVER, EBOOK_LIB_IRC_CHANNEL). Add them to your .env there.

# --- Cover search ---------------------------------------------------------
# Google Books cover search works without a key, but you can provide one for
# quota/reliability. To also search Google Images, create a Programmable Search
# Engine with image search enabled and set both CSE values.
EBOOK_LIB_GOOGLE_BOOKS_API_KEY=
EBOOK_LIB_GOOGLE_CSE_API_KEY=
EBOOK_LIB_GOOGLE_CSE_CX=

# Optional Hardcover API token for additional book cover matches.
EBOOK_LIB_HARDCOVER_API_KEY=
EBOOK_LIB_HARDCOVER_GRAPHQL_URL=https://api.hardcover.app/v1/graphql

# --- Host user (optional) -------------------------------------------------
# Match these to `id -u` / `id -g` if you want downloaded files owned by you.
PUID=1000
PGID=1000
